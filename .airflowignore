# Test suites and shared pytest configuration are not DAGs. Airflow would
# import them during DAG discovery, without running pytest's root conftest.py
# (which sets up their imports and stubs).
tests/
test/
test_*.py
*_test.py
conftest.py

# Local caches and virtualenvs must never be scanned for DAGs.
__pycache__/
venv/
.venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
